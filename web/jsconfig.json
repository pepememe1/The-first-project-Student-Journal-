{
  // Псевдоним `@` объявлен в vite.config.js — этого хватает СБОРЩИКУ, но не хватает
  // ничему, что читает исходники со стороны: редактору (переход к определению по
  // `@/stores/theme`), статическим анализаторам, построителю графа связей.
  // Здесь тот же псевдоним записан в стандартной форме, которую они понимают.
  // Один источник правды остаётся в vite.config.js — этот файл обязан ему зеркалить.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "dist-apk", "android"]
}
