<?xml version="1.0" encoding="utf-8"?>
<!--
  Стрелка «идёт сейчас» слева от предмета.

  Векторная, а не png: виджет живёт на экранах от mdpi до xxxhdpi, и растр пришлось бы
  класть шестью файлами. Цвет задан прямо здесь акцентом — RemoteViews не умеет
  красить drawable на лету (setColorFilter там недоступен), поэтому для приглушённого
  варианта заведён отдельный файл widget_arrow_past.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="14dp"
    android:height="14dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/gb_widget_accent"
        android:pathData="M8,5 L18,12 L8,19 Z" />
</vector>
