<?xml version="1.0" encoding="utf-8"?>
<!--
  Одна строка пары. Используется и в среднем, и в большом виджете — строки
  добавляются в контейнер через RemoteViews.addView().

  ⚠️ Почему не ListView/RemoteViewsService: адаптерный список в виджете требует
  отдельного сервиса, живёт своим процессом обновления и заметно медленнее
  просыпается. Пар в дне максимум 6-8 — статическая сборка строк проще, быстрее и
  не имеет «мигания пустым списком» при обновлении.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_row_bg"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Левая колонка: номер пары над временем. Ширина фиксирована, иначе строки
         «прыгают» друг относительно друга и колонка предметов теряет ровный край. -->
    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_pair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/gb_widget_text2"
            android:text="2 пара" />

        <TextView
            android:id="@+id/row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/gb_widget_text"
            android:text="10:45" />
    </LinearLayout>

    <!-- Центр: предмет и мелкая строка «тип · преподаватель/группа» -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="0.95"
            android:textSize="12sp"
            android:textColor="@color/gb_widget_text"
            android:text="Основы алгоритмизации" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="10sp"
            android:textColor="@color/gb_widget_text2"
            android:text="лек · Иванов И.И." />
    </LinearLayout>

    <!-- Аудитория -->
    <TextView
        android:id="@+id/row_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:maxLines="1"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/gb_widget_text3"
        android:text="3-301" />
</LinearLayout>
