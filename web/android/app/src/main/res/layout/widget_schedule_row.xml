<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка пары для СПИСКА (ListView) на среднем и большом виджете.

  ⚠️ Шрифты крупные СОЗНАТЕЛЬНО. Прошлая версия ужимала кегли, чтобы влезло больше
  строк, — и виджет становился нечитаемым на вытянутой руке, то есть терял смысл:
  расписание смотрят мельком, а не вчитываются. Теперь наоборот — шрифт крупный, а
  строки, которые не поместились, ПРОКРУЧИВАЮТСЯ (ListView), а не исчезают.

  ⚠️ Стрелка слева — ImageView с фиксированным местом (visibility=INVISIBLE, а НЕ
  GONE, у неактивных строк): при GONE соседние строки разъезжались бы по горизонтали
  на ширину стрелки, и список «дёргался» бы при каждой смене пары.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_row_bg"
    android:paddingLeft="6dp"
    android:paddingRight="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Стрелка «идёт сейчас». Своя ширина, чтобы строки не прыгали. -->
    <ImageView
        android:id="@+id/row_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/widget_arrow_now"
        android:contentDescription="@string/widget_now_desc" />

    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/gb_widget_text"
            android:text="10:45" />

        <TextView
            android:id="@+id/row_pair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="11sp"
            android:textColor="@color/gb_widget_text2"
            android:text="2 пара" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textColor="@color/gb_widget_text"
            android:text="Базы данных" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/gb_widget_text2"
            android:text="пр · Петрова А.С." />
    </LinearLayout>

    <TextView
        android:id="@+id/row_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/gb_widget_text3"
        android:text="2-215" />
</LinearLayout>
