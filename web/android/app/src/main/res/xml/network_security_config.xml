<?xml version="1.0" encoding="utf-8"?>
<!--
  Политика сети приложения: наружу ходим ТОЛЬКО по TLS.

  Зачем. В манифесте стоит usesCleartextTraffic="true" (так кладёт шаблон Capacitor),
  и он разрешает открытый HTTP ВСЕМУ приложению. Пока сессия жила пять часов, цена
  была невелика; теперь она живёт до понедельника, а на телефоне лежит копия оценок,
  и запрос по http в чужой сети отдаёт и токен, и данные тому, кто встал в середине.
  Тот же довод уже применён дважды в этом продукте: автообновление десктопа и
  самообновление виджета ходят исключительно по https.

  Оболочка приложения грузится с https://localhost (androidScheme по умолчанию в
  Capacitor 8), поэтому открытый трафик ей не нужен вовсе. Петля оставлена
  разрешённой отдельным правилом: встать в середину внутри одной машины негде, а
  запрет мешал бы отладке против локально поднятого сервера.

  Цена названа явно: колледж, поднявший свой сервер в ЛВС по http, из приложения
  работать не будет, пока у того сервера не появится https. Размен осознанный и
  такой же, как у автообновления десктопа.

  Действует с Android 7 (API 24) и перекрывает usesCleartextTraffic. На API 23
  сработает прежнее разрешающее значение из манифеста; убирать его насовсем не стали,
  не проверив на реальном устройстве.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
