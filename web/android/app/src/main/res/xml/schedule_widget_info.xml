<?xml version="1.0" encoding="utf-8"?>
<!--
  Описание виджета расписания для системы.

  ОДИН виджет на все размеры, а не три отдельных пункта в списке добавления:
  `resizeMode` даёт человеку растянуть его от 2×2 до 4×5, а провайдер выбирает
  раскладку по фактическим габаритам (см. ScheduleWidgetProvider.render). Три
  отдельных виджета заставляли бы удалять и добавлять заново ради смены размера.

  minWidth/minHeight = 2×2 клетки (по 70dp на клетку минус системные отступы).
  targetCellWidth/Height и maxResize* — атрибуты Android 12+; на более старых
  версиях (у нас minSdk 24) они просто игнорируются, поэтому отдельного файла
  под API 31 не нужно.

  updatePeriodMillis=1800000 (30 минут) — системный минимум. Меньше поставить
  нельзя, Android всё равно округлит вверх; точный будильник ради подсветки
  «идёт сейчас» не заводим (потребовал бы SCHEDULE_EXACT_ALARM на Android 12+).
-->
<!--
  ⚠️ `android:configure` ниже — экран настройки виджета. Система откроет его САМА при
  добавлении, и там человек выбирает, что показывать, каким шрифтом и насколько прозрачно.
  Виджет с `configure` НЕ появится на столе, пока экран не вернёт RESULT_OK — поэтому в
  самой активности результат выставляется первой строкой `onCreate` (см. её шапку), иначе
  кнопка «назад» оставила бы пустую заготовку.

  🔥 `previewImage` НУЖЕН ВМЕСТЕ С `previewLayout`, а не вместо (01.09.2026).
  `previewLayout` — атрибут API 31+ (Android 12). На Android 7–11, а `minSdkVersion = 24`,
  лаунчер его не понимает и ищет `previewImage`; без него в списке виджетов показывается
  иконка приложения или пустое место, а часть оболочек (MIUI, EMUI, ColorOS) такой виджет
  не рисует вовсе — со стороны это выглядит как «виджетов у приложения нет». Ровно на это
  и жаловались. Картинки рисует tools/build_widget_previews.py по той же раскладке.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="400dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:configure="ru.esstu.gradebook.ScheduleWidgetConfigure"
    android:initialLayout="@layout/widget_schedule_list"
    android:previewLayout="@layout/widget_schedule_list"
    android:previewImage="@drawable/widget_preview_4x2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_schedule_description"
    tools:targetApi="s" />
