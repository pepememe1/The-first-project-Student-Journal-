<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      allowBackup="false" вместо шаблонного "true". Резервная копия Android забирает
      ВСЁ приватное хранилище приложения, а там лежат токен сессии и локальная копия
      оценок в localStorage веб-оболочки. Копию снимает и adb backup на разблокированном
      телефоне, и облачный автобэкап. Пока сессия жила пять часов, украденная копия
      быстро протухала; теперь она живёт до понедельника, и такой подарок отдавать
      нельзя. Терять при этом нечего: всё содержимое и так восстанавливается входом.

      usesCleartextTraffic здесь УЖЕ НИЧЕГО НЕ РЕШАЕТ: minSdkVersion = 24 (Android 7,
      web/android/variables.gradle), а с Android 7 его целиком перекрывает
      networkSecurityConfig, где открытый HTTP запрещён везде, кроме петли (см. сам файл).
      Флаг оставлен только потому, что его кладёт шаблон Capacitor; ветки «Android 6», о
      которой тут раньше было написано, не существует — на такие телефоны приложение не
      ставится вовсе.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Приём пуш-уведомлений RuStore. exported="false": сервис дёргает только
             сам SDK внутри процесса, снаружи к нему обращаться незачем. -->
        <service
            android:name=".GradeBookPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="ru.rustore.sdk.pushclient.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Виджет расписания на рабочем столе.

             🔥 `exported="true"` ОБЯЗАТЕЛЕН, и прежнее `false` было настоящим дефектом
             (01.09.2026): у человека виджет вообще не появлялся в списке добавления, и
             поставить его было нельзя. Прежний комментарий здесь объяснял запрет так —
             «наш собственный провайдер, снаружи дёргать нечего», — и это неверно по
             существу: широковещательные сообщения виджету шлёт СИСТЕМА, а список
             виджетов рисует ЛАУНЧЕР, и оба они — сторонние для нас приложения. С
             `exported="false"` часть оболочек (MIUI, EMUI, ColorOS и другие) просто не
             показывает такой виджет.
             ⚠️ Опасности в экспорте нет: провайдер принимает только системные действия
             из intent-filter ниже и ничего не отдаёт наружу.

             Приёмник слушает ещё и смену даты/времени, иначе после полуночи виджет до
             получаса показывал бы вчерашний день (см. onReceive). -->
        <!--
          Экран настройки виджета. `exported="true"` обязателен: его запускает СИСТЕМА
          (лаунчер) при добавлении виджета, а не наше приложение. Без этого добавление
          виджета молча заканчивается ничем — заготовка исчезает, ошибки человек не видит.
          ⚠️ Опасности в экспорте здесь нет: активность принимает только id виджета и
          ничего не читает из чужих данных. Наружу она тоже ничего не отдаёт.
        -->
        <activity
            android:name=".ScheduleWidgetConfigure"
            android:label="@string/wcfg_title"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ScheduleWidgetProvider"
            android:label="@string/widget_schedule_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>

        <!-- Три отдельных пункта в списке добавления: 2x2, 4x2 и 4x4. Отличаются только
             стартовым размером и картинкой предпросмотра, вся логика в общем предке
             (см. ScheduleWidgetSizes). Растягивать по-прежнему можно: раскладку решает
             фактический размер ячейки, а не выбранный пункт.
             Приёмник выше (.ScheduleWidgetProvider) оставлен ради уже размещённых
             виджетов прошлой версии: удалить его значило бы, что после обновления
             приложения виджет с рабочего стола молча исчезнет. -->
        <receiver
            android:name=".ScheduleWidgetSizes$Small"
            android:label="@string/widget_schedule_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_2x2" />
        </receiver>

        <receiver
            android:name=".ScheduleWidgetSizes$Medium"
            android:label="@string/widget_schedule_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_4x2" />
        </receiver>

        <receiver
            android:name=".ScheduleWidgetSizes$Large"
            android:label="@string/widget_schedule_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_4x4" />
        </receiver>

        <!-- Поставщик строк для прокручиваемого списка пар.
             ⚠️ BIND_REMOTEVIEWS обязателен: без этого разрешения система откажется
             привязываться к сервису, и список останется навсегда пустым — причём молча,
             в логе будет только SecurityException от системного процесса. -->
        <service
            android:name=".ScheduleWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Идентификатор проекта из консоли RuStore. НЕ секрет (он виден в APK), в
             отличие от сервисного токена — тот живёт только на сервере в .env. -->
        <meta-data
            android:name="ru.rustore.sdk.pushclient.project_id"
            android:value="${rustoreProjectId}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ требует явного разрешения на показ уведомлений; на более старых
         версиях оно выдаётся при установке и запрос просто пропускается. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      VIBRATE — тактильная отдача (короткий отклик на подтверждение, отказ и важное
      событие; web/src/utils/haptics.js).

      ⚠️ Разрешение нужно даже для веб-API `navigator.vibrate`: без него WebView молча
      ничего не делает — ни ошибки, ни исключения, вызов просто возвращает false. То есть
      отсутствие этой строки выглядело бы как «вибрация не работает на этом телефоне», и
      искать причину пришлось бы в коде, где всё правильно.

      ⚠️ Разрешение НЕ опасное (normal): системного запроса человеку не показывается,
      диалога согласия нет. Выключается оно в наших настройках, а не в системных, и по
      умолчанию включено — способность есть, значит должна быть под рукой.

      Плагин @capacitor/haptics намеренно НЕ ставим: он нативный, а значит каждая правка
      отдачи требовала бы пересборки APK и перезалива в RuStore. Веб-API едет обычным
      OTA-бандлом.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- REQUEST_INSTALL_PACKAGES убрано по требованию модерации RuStore: нативная
         установка APK в обход магазина запрещена. Обновления приложения — только через
         RuStore; веб-слой обновляется незаметно через Capgo OTA (установка APK не нужна). -->
</manifest>
