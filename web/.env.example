# ============================================================
# .env.example — переменные сборки веб-версии GradeBookAI
# Скопируйте в .env и при необходимости измените. Для обычной
# сборки (сайт и API на одном адресе) МЕНЯТЬ НИЧЕГО НЕ НУЖНО.
# ============================================================

# База API. Пусто = тот же origin, что и сайт (рекомендуется: сайт и API за одним
# Caddy/Nginx на одном домене → CORS не нужен, «адрес сервера = адрес сайта»).
# Заполняйте, только если фронтенд должен смотреть на ДРУГОЙ адрес сервера.
VITE_API_BASE=

# Куда dev-сервер (npm run dev) проксирует API-запросы. По умолчанию локальный FastAPI.
VITE_API_TARGET=http://localhost:8000
