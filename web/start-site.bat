@echo off
rem ============================================================
rem start-site.bat — запуск САЙТА (веб-версия). Просто дважды кликни.
rem Откроется окно, соберётся адрес http://localhost:5173
rem ============================================================
cd /d "%~dp0"
if not exist "node_modules" (
  echo [1/2] Первый запуск: ставлю зависимости...
  call npm install
)
echo [2/2] Запускаю сайт. Открой в браузере http://localhost:5173
echo Чтобы остановить — закрой это окно или нажми Ctrl+C.
call npm run dev
pause
