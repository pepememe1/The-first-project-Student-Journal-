# ⛔ ОБРАЗЕЦ. НЕ БОЕВОЙ КОНФИГ. НЕ РАЗВОРАЧИВАТЬ ПО НЕМУ.
# ═══════════════════════════════════════════════════════════════════════════════
# Помечено 03.09.2026. Файл лежит с 11.07.2026, на него не ссылается ни один
# скрипт развёртывания, и домен в нём (`gradebookai.ru`) продукту не принадлежит —
# боевой адрес `esstu-gradebook.ru`. Оставлен как исторический черновик, но
# развернуть по нему сервер нельзя, и вот чем это кончится:
#
#   • НИ ОДНОГО заголовка безопасности: нет HSTS, CSP, X-Frame-Options,
#     Referrer-Policy, Permissions-Policy. Мета-CSP в index.html спасает только
#     страницу; API-ответы остаются голыми, встраивание журнала в чужой фрейм
#     ничем не закрыто;
#   • НЕТ ЛИМИТА ТЕЛА ЗАПРОСА — тело на гигабайт принимается в память машины
#     с 960 МБ. Самый дешёвый способ положить сервер;
#   • НЕТ ТАЙМАУТОВ — slowloris держит соединения бесплатно;
#   • 🔥 ГЛАВНОЕ: пересылка идёт БЕЛЫМ СПИСКОМ путей (`@api path ...`), а это ровно
#     тот дефект, о котором предупреждает боевой конфиг. В списке ниже НЕТ
#     `/app/*` (OTA-обновления телефонов), `/downloads/*` и `/desktop/updates`
#     (обновление десктопа), `/public/schedule*` и `/schedule/*` (расписание без
#     входа). Развернув это, вы получите не «медленно», а 404 там, где у людей
#     обновления и расписание — при полностью зелёном сайте и живом входе.
#
# Боевой конфиг — `server/Caddyfile`, он под тестом (`server/tests/test_caddyfile.py`).
# Правьте его, а не этот файл. Держит `test_every_other_caddyfile_is_marked_as_a_sample`.
# ═══════════════════════════════════════════════════════════════════════════════

# ============================================================
# Caddyfile — «один адрес» для сайта и API GradeBookAI.
#
# Идея (совпадает с server/DEPLOY.md десктопа): Caddy отдаёт статику SPA в корне
# домена, а известные API-префиксы проксирует в FastAPI (uvicorn на :8000). Тогда:
#   • адрес сайта = адрес сервера (одно доменное имя, один сертификат);
#   • CORS не нужен — фронтенд ходит на свой же origin;
#   • десктоп-прога указывает ТОТ ЖЕ адрес (она бьёт в /auth, /sync — они проксируются).
#
# Что нужно: собрать фронт (`npm run build` → папка dist) и указать путь к ней ниже.
# TLS Caddy получает и продлевает сам (Let's Encrypt) — важно для 152-ФЗ, т.к. TLS
# терминируется на вашем ПК/сервере, а не у иностранного посредника.
# ============================================================

gradebookai.ru {
	# ── API: проксируем в FastAPI. Реальный IP клиента доходит до сервера
	#    (X-Forwarded-For) — серверный анти-брутфорс это учитывает.
	@api path /auth/* /me/* /sync/* /admin/* /connect/* /web/* /health /docs /docs/* /openapi.json
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	# ── SPA: всё остальное — статика Vue. try_files с фолбэком на index.html,
	#    чтобы глубокие ссылки (/admin/monitor и т.п.) открывались напрямую.
	handle {
		root * /var/www/gradebookai/dist
		encode gzip zstd
		try_files {path} /index.html
		file_server
	}
}
