# ── Рантайм-данные и секреты (НИКОГДА не коммитим) ──
secure_data.enc          # зашифрованный мастер-ключ
pg_config.json           # параметры подключения к PostgreSQL (пароль БД!)
install_key.txt          # ключ установки ПК
data.key                 # ключ шифрования ПДн (защищён DPAPI, но не в Git)
audit.log                # журнал событий безопасности
login_throttle.json      # состояние анти-брутфорса
*.db                     # локальные базы SQLite (vsgutu_grades.db)
*.db-journal
*.db-wal
*.db-shm
backups/                 # авто-бэкапы базы
*.bak

# ── Конфигурация окружения ──
.env
.env.*
!.env.example          # шаблон коммитим (реальные секреты — нет)

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Виртуальные окружения ──
.venv/
venv/
env/
ENV/

# ── Сборка PyInstaller ──
*.spec
*.manifest

# ── IDE / редакторы ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── ОС ──
.DS_Store
Thumbs.db
desktop.ini
