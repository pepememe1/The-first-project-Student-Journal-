__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Виртуальные окружения ──
.venv/
venv/
env/
ENV/

# ── Сборка PyInstaller ──
*.spec
*.manifest

# ── IDE / редакторы ──
.vscode/
.idea/
*.swp
*.swo
*~

