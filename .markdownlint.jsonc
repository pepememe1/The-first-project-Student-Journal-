// Конфиг markdownlint для документации репозитория (README.md, docs/*.md) и
// локальных заметок команды.
//
// Принцип тот же, что у ESLint в web/ и у allowlist mypy в pyproject.toml: ловим то,
// что РЕАЛЬНО ломает отображение, и молчим про стиль. Без этого файла расширение
// выдаёт больше сотни предупреждений на одном длинном документе — а инструмент,
// который шумит, перестают читать (то же правило, что у подтверждения опасных команд
// в разделе про раздел «Сервер»: ложные срабатывания вреднее пропусков).
//
// ОСТАЮТСЯ ВКЛЮЧЁННЫМИ (ломают рендер или являются опечаткой, не стилем):
//   MD031 — нет пустой строки вокруг ``` → блок кода не отрендерится блоком
//   MD032 — нет пустой строки вокруг списка → список слипнется в абзац
//   MD011 — перевёрнутый синтаксис ссылки (url)[текст] → ссылка не работает
//   MD042 — пустая ссылка
//   MD040 — у блока кода не указан язык → теряется подсветка
//   MD047 — нет перевода строки в конце файла → шум в git diff
//
// README.md ПУБЛИЧНЫЙ (лежит на GitHub, его читает покупатель) — битая таблица или
// слипшийся список видны всем. Поэтому структурные правила и оставлены включёнными.
{
  // Длина строки. Наша документация свёрстана под ~95 колонок вручную — это осознанно.
  "MD013": false,

  // Инлайновый HTML: нужен для таблиц и переносов в длинных документах.
  "MD033": false,

  // «Первая строка обязана быть заголовком»: часть документов начинается с блока-цитаты.
  "MD041": false,

  // Нумерация списков: внутри длинных разборов нумерация перезапускается по блокам.
  "MD029": false,

  // Стиль выделения (* против _). Встречаются оба, различать смысла нет.
  "MD050": false,
  "MD049": false,

  // Жирный вместо заголовка — приём наших заметок: «**Баг 1 —** …» без уровня заголовка.
  "MD036": false,

  // Перескок уровней заголовков (## сразу на ####) — бывает в длинных разборах.
  "MD001": false,

  // Одинаковые заголовки разрешены в РАЗНЫХ разделах, но не рядом друг с другом —
  // там это уже опечатка.
  "MD024": { "siblings_only": true },

  // Несколько пустых строк подряд используются как разделитель смысловых блоков.
  "MD012": false,

  // Стиль и отступ маркеров списка: смешаны исторически, переучивать людей не будем.
  "MD004": false,
  "MD007": false,

  // Знаки препинания в заголовке — у нас заголовки-предложения с двоеточием и тире.
  "MD026": false,

  // Голый URL: внутри технических заметок читается лучше, чем [url](url).
  "MD034": false,

  // Хвостовые пробелы — шумно и на наш рендер не влияет.
  "MD009": false,

  // Картинка без alt — картинок в доках почти нет.
  "MD045": false,

  // MD038 «пробелы внутри `code`» — для нашей вёрстки ЛОЖНОЕ срабатывание (63 штуки
  // из 107 на одном документе). Проверено поимённо: пробелов внутри спанов там нет.
  // Причина — ручная вёрстка под ~95 колонок: длинный code-span переносится через
  // строку, и правило считает перенос пробелом внутри. Ломает это только сам отчёт
  // линтера, не рендер. Соберёшься снять глушилку — сначала перечитай этот абзац,
  // а не начинай «чинить» 63 несуществующие ошибки.
  "MD038": false,

  // Лишние пробелы после «>» в цитате: длинные блоки-цитаты выровнены отступами.
  "MD027": false,

  // Стиль оформления колонок таблицы (выравнивание разделителей) — чистая косметика.
  "MD060": false
}
