# Пример переменных окружения бэкенда. Скопируйте в server/.env и заполните.
# На боевом сервере ВСГУТУ задайте реальные значения; .env в Git НЕ коммитим.

# Строка подключения к БД.
#   Разработка (по умолчанию):   sqlite:///./gradebook_server.db
#   Боевой сервер (PostgreSQL):  postgresql://vsgutu_user:ПАРОЛЬ@localhost:5432/vsgutu_grades
GRADEBOOK_DB_URL=sqlite:///./gradebook_server.db

# Секрет для подписи JWT-токенов. ОБЯЗАТЕЛЬНО смените на длинную случайную строку.
GRADEBOOK_JWT_SECRET=change-me-to-a-long-random-secret

# Время жизни токена в минутах (по умолчанию 12 часов).
GRADEBOOK_JWT_TTL_MIN=720
