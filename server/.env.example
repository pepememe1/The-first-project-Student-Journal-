# ============================================================================
# Пример переменных окружения сервера. Скопируйте в server/.env и заполните.
# .env в Git НЕ коммитим. Права на файл — 600.
#
# ⚠️ ПЕРЕПИСАН 04.09.2026. Прежняя редакция состояла из ЧЕТЫРЁХ переменных, из
# которых одна описывала PostgreSQL (его больше нет), а другая обещала срок
# токена 720 минут при действующих жёстких 5 часах. В ней НЕ БЫЛО:
#   • GRADEBOOK_DB_KEY — без него файл базы не шифруется вовсе, и ПДн студентов
#     лежат на диске открытым текстом. Отказ ТИХИЙ: продукт работает как ни в
#     чём не бывало;
#   • GRADEBOOK_TRUST_IPS — без него первый же студент со сканером банит по IP
#     ВЕСЬ колледж: он сидит за одним NAT.
# Неполный пример опаснее отсутствующего: по нему заполняют и считают, что
# настроили всё.
#
# 🔑 СЕКРЕТЫ ЧИТАЮТСЯ НЕ ТОЛЬКО ОТСЮДА. Порядок (app/secrets_source.py):
#   учётные данные службы systemd → файл <ПЕРЕМЕННАЯ>_FILE → переменная окружения.
# На бою предпочтительны первые два: переменные процесса видны в
# /proc/<pid>/environ и в `systemctl show`, то есть ключ от базы с ПДн читает
# любой, кто получил root.
# ============================================================================

# ── БАЗА ───────────────────────────────────────────────────────────────────
# База у продукта ОДНА — SQLite (на бою под SQLCipher). Поддержка PostgreSQL
# убрана 04.09.2026 целиком, см. шапку server/app/db.py.
GRADEBOOK_DB_URL=sqlite:///./gradebook_server.db

# 🔒 ОБЯЗАТЕЛЬНО НА БОЮ. Ключ шифрования файла базы: РОВНО 64 hex-символа
# (32 байта). Сгенерировать: openssl rand -hex 32
# Пусто или нет драйвера sqlcipher3 → база работает БЕЗ шифрования файла (это
# нормально для разработки на Windows и недопустимо на бою).
# ⚠️ ПОТЕРЯ ЭТОГО КЛЮЧА = ПОТЕРЯ ВСЕЙ БАЗЫ. Резервные копии зашифрованы им же.
# Храните копию вне сервера.
GRADEBOOK_DB_KEY=

# ── ВХОД И ТОКЕНЫ ──────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО смените: openssl rand -hex 32
GRADEBOOK_JWT_SECRET=change-me-to-a-long-random-secret

# Срок жизни токена, минуты. 300 = 5 часов, и это ЖЁСТКОЕ значение по умолчанию:
# потолок защищает ровно от «отошёл от ОБЩЕГО компьютера, не выйдя из аккаунта».
# refresh живёт столько же — иначе он копился бы до сотен часов.
GRADEBOOK_JWT_TTL_MIN=300
GRADEBOOK_JWT_REFRESH_TTL_MIN=300

# У кого включён второй фактор — сессия длиннее: неделя на сайте и в программе,
# месяц в мобильном приложении. Размен честный: с двумя факторами одного пароля
# для входа мало. Потолок пересчитывается от ТЕКУЩЕГО состояния — снял фактор,
# и сессии сразу судятся по короткой политике.
GRADEBOOK_JWT_MFA_TTL_MIN=10080
GRADEBOOK_JWT_MFA_MOBILE_TTL_MIN=43200

# Домен и разрешённые источники (CORS).
GRADEBOOK_DOMAIN=esstu-gradebook.ru
GRADEBOOK_ALLOWED_ORIGINS=https://esstu-gradebook.ru

# ── ЗАЩИТА: ПРИМАНКИ ───────────────────────────────────────────────────────
# 🔴 БЕЛЫЙ СПИСОК АДРЕСОВ ОБЯЗАТЕЛЕН. Обращение к пути-приманке (/.env,
# /wp-login.php и т.п.) даёт немедленный бан по IP. Колледж сидит за ОДНИМ NAT:
# один студент, запустивший сканер с ноутбука, отрежет всё здание, и выглядеть
# это будет как отказ сервера. Впишите внешние адреса колледжа через запятую.
# Петля (127.0.0.1) доверена всегда — иначе локальный сервер забанил бы сам себя.
GRADEBOOK_TRUST_IPS=

# ── ШИФРОВАНИЕ ПОЛЕЙ ПДн ───────────────────────────────────────────────────
# Ключи шифрования отдельных полей и поискового индекса (openssl rand -hex 32).
GRADEBOOK_DATA_KEY=
GRADEBOOK_INDEX_KEY=

# 1 — включает сертифицированный ГОСТ-режим (нужен OpenSSL GOST-engine/ViPNet).
# Установщик определяет наличие движка сам; здесь — ручное переопределение.
GRADEBOOK_VIPNET=0

# ── ЖЕЛЕЗО И ТЯЖЁЛЫЕ ФУНКЦИИ ───────────────────────────────────────────────
# Класс машины определяется САМ по памяти и числу ядер (app/hostcaps.py).
# Здесь — переопределение на случай, когда автоопределение ошиблось (необычный
# контейнер, урезанный /proc): auto | workstation | vps
# ⚠️ Тумблера «включить перевод/распознавание» нет и не будет: продукт решает
# это по НАЛИЧИЮ пакета и моделей, а не по настройке, которую надо вспомнить.
GRADEBOOK_HOST_TIER=auto

# ── ВЛОЖЕНИЯ ───────────────────────────────────────────────────────────────
# Способ хранения выбирает машина: есть ключи S3 → объектное хранилище; нет, но
# свободно ≥ порога → диск; места мало → вложения честно выключены (503).
# Явно: off | local | s3 | auto
GRADEBOOK_FILES_MODE=auto
GRADEBOOK_FILES_MIN_FREE_GB=20
GRADEBOOK_S3_MAX_MB=25
# Суточный потолок на ЧЕЛОВЕКА. Без него один аккаунт занимает хранилище за
# вечер, а остальные получают «места нет» — отказ, который читается как поломка
# сервера, а не как чьё-то злоупотребление.
GRADEBOOK_FILES_USER_DAY_MB=200
GRADEBOOK_S3_ENDPOINT=
GRADEBOOK_S3_REGION=ru-central1
GRADEBOOK_S3_BUCKET=
GRADEBOOK_S3_KEY=
GRADEBOOK_S3_SECRET=

# ── ПУТИ ───────────────────────────────────────────────────────────────────
GRADEBOOK_WEB_DIST=/root/gb-deploy/webdist
GRADEBOOK_DOWNLOADS=/root/gb-deploy/downloads
GRADEBOOK_DEPLOY_ROOT=/root/gb-deploy
GRADEBOOK_BACKUP_DIR=/root/gb-backups/auto

# Идентификатор машины-хоста (генерируется установщиком).
GRADEBOOK_HOST_DEVICE_ID=

# ── ПОЧТА (восстановление пароля, приглашения) ─────────────────────────────
GRADEBOOK_SMTP_HOST=
GRADEBOOK_SMTP_PORT=587
GRADEBOOK_SMTP_USER=
GRADEBOOK_SMTP_PASS=
GRADEBOOK_SMTP_FROM=
GRADEBOOK_SMTP_FROM_NAME=GradeBookAI
GRADEBOOK_SITE_URL=https://esstu-gradebook.ru

# ── ВХОД ПО PASSKEY (WebAuthn) ─────────────────────────────────────────────
GRADEBOOK_WEBAUTHN_RP_ID=esstu-gradebook.ru
GRADEBOOK_WEBAUTHN_RP_NAME=GradeBookAI
GRADEBOOK_WEBAUTHN_ORIGIN=https://esstu-gradebook.ru

# ── ПРОЧЕЕ ─────────────────────────────────────────────────────────────────
# Аварийный тумблер озвучки Вектора: off глушит обращения к LLM.
GRADEBOOK_VECTOR_LLM=
# Ключ поиска GIF (Klipy). Не задан — панель GIF просто не работает.
GRADEBOOK_KLIPY_API_KEY=
# Пуши в мобильное приложение (RuStore).
GRADEBOOK_RUSTORE_PROJECT_ID=
GRADEBOOK_RUSTORE_SERVICE_TOKEN=
# Часовой пояс колледжа (Улан-Удэ = UTC+8).
GRADEBOOK_TZ_OFFSET_H=8
# Открыть /docs и /redoc. На бою держать выключенным.
GRADEBOOK_ENABLE_DOCS=0
