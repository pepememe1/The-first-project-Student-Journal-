{
	servers {
		protocols h1 h2
	}
}

esstu-gradebook.ru {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# frame-src — Фаза 1 видео-эмбедов мессенджера (docs/MESSENGER-ATTACHMENTS-PLAN.md):
		# без него default-src 'self' блокирует ЛЮБОЙ <iframe>, и белый список видеохостингов
		# (YouTube/VK/Rutube, см. web/src/utils/videoEmbed.js) не открылся бы вовсе.
		# img-src static.klipy.com — GIF-пикер мессенджера (3.5.5, gif_service.py): без него
		# CSP молча блокирует <img> на превью и отправленные GIF (белый список хоста тот же,
		# что и на сервере — gif_service.is_allowed_url).
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://static.klipy.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; frame-src https://www.youtube.com https://vk.com https://rutube.ru; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'"
		-Server
	}
	# Реальный IP клиента из ПРОВЕРЕННОГО TCP-пира (клиент подделать не может — Caddy
	# перезаписывает). Сервер (throttle.client_ip) доверяет ему для анти-брутфорса; без
	# него первый элемент X-Forwarded-For спуфится и защита от перебора пароля обходится.
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Real-IP {remote_host}
	}
}
