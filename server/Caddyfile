esstu-gradebook.ru {
	reverse_proxy 127.0.0.1:8000 {
		# Реальный IP клиента из ПРОВЕРЕННОГО TCP-пира. Клиент этот заголовок подделать
		# не может — Caddy его перезаписывает. Сервер (throttle.client_ip) доверяет ему
		# для анти-брутфорса; без него первый элемент X-Forwarded-For спуфится и защита
		# от перебора пароля обходится.
		header_up X-Real-IP {remote_host}
	}
}
