{
	servers {
		protocols h1 h2
	}
}

esstu-gradebook.ru {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'"
		-Server
	}
	# Реальный IP клиента из ПРОВЕРЕННОГО TCP-пира (клиент подделать не может — Caddy
	# перезаписывает). Сервер (throttle.client_ip) доверяет ему для анти-брутфорса; без
	# него первый элемент X-Forwarded-For спуфится и защита от перебора пароля обходится.
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Real-IP {remote_host}
	}
}
