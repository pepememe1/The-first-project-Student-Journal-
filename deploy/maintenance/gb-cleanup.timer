[Unit]
Description=Запуск gb-cleanup раз в неделю, в ночь на воскресенье по Улан-Удэ

[Timer]
# Ночь на воскресенье, 03:30 по Иркутску. Порядок ночи выстроен намеренно:
#   00:00 — снимок базы (gb-backup.timer),
#   02:00–02:15 — автообновления безопасности (apt-daily-upgrade.timer, см. drop-in рядом)
#                 и перезагрузка, если её требует ядро;
#   03:30 — эта уборка: заодно убирает .deb, скачанные обновлением.
# Час запаса после обновления — не перестраховка: на одном ядре большая пачка пакетов
# ставится дольше получаса, и apt-get clean упёрся бы в блокировку apt (так было бы в
# 02:30, Полковник 14.10.2026). Скрипт такой пропуск переживает, но кэш стоял бы неделю.
# Таймзона указана прямо в OnCalendar, как у gb-backup: машина живёт по Москве, а
# колледж — по Улан-Удэ, и после переезда на железо ВСГУТУ зона машины может смениться.
OnCalendar=Sun *-*-* 03:30:00 Asia/Irkutsk
# Пропущенный из-за выключенной машины запуск наверстать при следующем старте.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
