# GradeBookAI — еженедельное обновление всех пакетов ОС (gb_os_update.sh), 27.10.2026.
[Unit]
Description=GradeBookAI weekly OS update (all packages, reboot if required)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /root/gb-deploy/maintenance/gb_os_update.sh
TimeoutStartSec=1h
