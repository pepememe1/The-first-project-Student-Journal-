[Unit]
Description=Запуск gb-backup каждый день в 00:00 по Улан-Удэ (Asia/Irkutsk, UTC+8)

[Timer]
# Полночь по бурятскому времени. Таймзона указана прямо в OnCalendar — не зависим от
# того, в какой зоне живёт сама машина (сейчас UTC/MSK — не важно). systemd 255
# (Ubuntu 24.04) суффикс таймзоны поддерживает.
OnCalendar=*-*-* 00:00:00 Asia/Irkutsk
# Пропущенный из-за выключенной машины запуск наверстать при следующем старте.
Persistent=true
# Небольшой разброс, чтобы не стартовать ровно в секунду вместе с ротацией логов и пр.
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
